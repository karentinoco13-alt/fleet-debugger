{
  "history_db": "/var/lib/fleetdebug/history.db",
  "poll_interval_s": 15,
  "silent_after_s": 120,
  "ingest_token": "CHANGE-ME-ingest-token",
  "drones": [
    {
      "name": "dock07-drone",
      "site": "Refinery North",
      "url": "http://10.8.0.17:8765",
      "token": "CHANGE-ME",
      "action_secret": "CHANGE-ME-per-vehicle-random-secret"
    },
    {
      "name": "rover-12",
      "site": "Pipeline Corridor",
      "action_secret": "CHANGE-ME"
    }
  ],
  "notify": [
    {
      "type": "slack",
      "url": "https://hooks.slack.com/services/XXX",
      "min_severity": "critical"
    },
    {
      "type": "webhook",
      "url": "https://ops.example.com/hooks/drone-events",
      "min_severity": "warning",
      "headers": {
        "X-Api-Key": "CHANGE-ME"
      }
    }
  ],
  "users": {
    "karen": "<output of: python3 -m fleetdebug hash-password>"
  },
  "command_ttl_s": 300,
  "metrics_public": false
}